    <Paragraph Number="1" Type="Scene Heading" mm:block-id="blk_01J6NE390B000000000000000B" mm:scene-id="scn_01J6NE39060000000000000006" mm:scene-number="1" mm:schema-version="1.0">
      <Text>INT. KITCHEN - DAY</Text>
    </Paragraph>
    <Paragraph Type="Action" mm:block-id="blk_01J6NE390C000000000000000C" mm:scene-id="scn_01J6NE39060000000000000006" mm:schema-version="1.0">
      <Text>Ada studies the lock.</Text>
    </Paragraph>
    <Paragraph Type="Character" mm:block-id="blk_01J6NE390D000000000000000D" mm:character-cue-id="cue_01J6NE39070000000000000007" mm:dialogue-pair-id="dlg_01J6NE39080000000000000008" mm:scene-id="scn_01J6NE39060000000000000006" mm:schema-version="1.0">
      <Text>ADA</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" mm:block-id="blk_01J6NE390E000000000000000E" mm:dialogue-pair-id="dlg_01J6NE39080000000000000008" mm:scene-id="scn_01J6NE39060000000000000006" mm:schema-version="1.0">
      <Text>quietly</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" mm:block-id="blk_01J6NE390F000000000000000F" mm:dialogue-pair-id="dlg_01J6NE39080000000000000008" mm:scene-id="scn_01J6NE39060000000000000006" mm:schema-version="1.0">
      <Text>It's not locked.</Text>
    </Paragraph>
    <Paragraph Type="Transition" mm:block-id="blk_01J6NE390G000000000000000G" mm:scene-id="scn_01J6NE39060000000000000006" mm:schema-version="1.0">
