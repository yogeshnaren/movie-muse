      <mm:SceneRef id="scn_01J6NE393C000000000000003C"/>
      <mm:SceneRef id="scn_01J6NE393D000000000000003D"/>
    </mm:Sequence>
  </mm:Sequences>
  <mm:Notes>
    <mm:Note author-actor-id="act_01J6NE39350000000000000035" block-id="blk_01J6NE393T000000000000003T" created-at="2026-09-01T00:00:00Z" id="note_01J6NE393K000000000000003K" resolved="false" schema-version="1.0">Keep the rain practical, not decorative.</mm:Note>
  </mm:Notes>
