# Copy to `.env` for local development. Never commit `.env`.
# Real provider credentials belong in the Cloud Agent / operator secret store,
# not in source control.

MOVIE_MUSE_ENV=development

# Leave provider keys empty until the owning work package is runnable.
# OPENAI_API_KEY=YOUR_KEY_HERE
# ANTHROPIC_API_KEY=YOUR_KEY_HERE
# ZOOM_CLIENT_ID=YOUR_KEY_HERE
# ZOOM_CLIENT_SECRET=YOUR_KEY_HERE
# GOOGLE_MEET_CLIENT_ID=YOUR_KEY_HERE
# GOOGLE_MEET_CLIENT_SECRET=YOUR_KEY_HERE
# IMAGE_PROVIDER_API_KEY=YOUR_KEY_HERE
# VIDEO_PROVIDER_API_KEY=YOUR_KEY_HERE
