{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moviemuse.local/schemas/domain/epistemic-inferred-claim-v1.json",
  "title": "InferredClaim",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "subject_id", "attribute", "value", "confidence", "evidence_bundle_id", "model_id", "kind", "schema_version"],
  "properties": {
    "id": {"$ref": "common-v1.json#/$defs/inferredClaimId"},
    "subject_id": {"type": "string", "minLength": 1},
    "attribute": {"type": "string", "minLength": 1},
    "value": true,
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "evidence_bundle_id": {"$ref": "common-v1.json#/$defs/evidenceBundleId"},
    "model_id": {"type": "string", "minLength": 1},
    "kind": {"const": "inferred"},
    "schema_version": {"$ref": "common-v1.json#/$defs/schemaVersion"}
  }
}
