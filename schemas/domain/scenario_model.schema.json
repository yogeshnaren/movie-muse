{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moviemuse.local/schemas/domain/scenario-model-v1.json",
  "title": "ScenarioModel",
  "$defs": {
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["percentile", "value", "unit"],
      "properties": {
        "percentile": {"$ref": "common-v1.json#/$defs/percentile"},
        "value": {"type": "number"},
        "unit": {"type": "string", "minLength": 1}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "project_id", "methodology_summary", "model_version", "data_as_of",
    "computed_at", "outcomes", "is_out_of_distribution", "schema_version"
  ],
  "properties": {
    "id": {"$ref": "common-v1.json#/$defs/scenarioModelId"},
    "project_id": {"$ref": "common-v1.json#/$defs/projectId"},
    "methodology_summary": {"type": "string", "minLength": 1},
    "model_version": {"type": "string", "minLength": 1},
    "data_as_of": {"$ref": "common-v1.json#/$defs/timestamp"},
    "computed_at": {"$ref": "common-v1.json#/$defs/timestamp"},
    "outcomes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/outcome"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "comparables": {"type": "array", "items": {"type": "string"}},
    "uncertainty_notes": {"type": ["string", "null"]},
    "is_out_of_distribution": {"type": "boolean"},
    "schema_version": {"$ref": "common-v1.json#/$defs/schemaVersion"}
  }
}
