{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moviemuse.local/schemas/domain/epistemic-structural-fact-v1.json",
  "title": "StructuralFact",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "subject_id", "attribute", "value", "derived_from_revision_id", "extractor_version", "kind", "schema_version"],
  "properties": {
    "id": {"$ref": "common-v1.json#/$defs/structuralFactId"},
    "subject_id": {"type": "string", "minLength": 1},
    "attribute": {"type": "string", "minLength": 1},
    "value": true,
    "derived_from_revision_id": {"$ref": "common-v1.json#/$defs/revisionId"},
    "extractor_version": {"type": "string", "minLength": 1},
    "kind": {"const": "structural"},
    "schema_version": {"$ref": "common-v1.json#/$defs/schemaVersion"}
  }
}
