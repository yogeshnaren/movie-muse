{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moviemuse.local/schemas/domain/epistemic-authored-fact-v1.json",
  "title": "AuthoredFact",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "subject_id", "attribute", "value", "source_revision_id", "author_actor_id", "kind", "schema_version"],
  "properties": {
    "id": {"$ref": "common-v1.json#/$defs/authoredFactId"},
    "subject_id": {"type": "string", "minLength": 1},
    "attribute": {"type": "string", "minLength": 1},
    "value": true,
    "source_revision_id": {"$ref": "common-v1.json#/$defs/revisionId"},
    "author_actor_id": {"$ref": "common-v1.json#/$defs/actorId"},
    "kind": {"const": "authored"},
    "schema_version": {"$ref": "common-v1.json#/$defs/schemaVersion"}
  }
}
