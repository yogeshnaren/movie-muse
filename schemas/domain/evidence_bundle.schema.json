{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moviemuse.local/schemas/domain/evidence-bundle-v1.json",
  "title": "EvidenceBundle",
  "$defs": {
    "citedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "rights_record_id", "excerpt_summary"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "rights_record_id": {"$ref": "common-v1.json#/$defs/rightsRecordId"},
        "excerpt_summary": {"type": "string"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "claim", "method_summary", "model_id", "model_version",
    "confidence", "created_at", "human_validation_state", "schema_version"
  ],
  "properties": {
    "id": {"$ref": "common-v1.json#/$defs/evidenceBundleId"},
    "claim": {"type": "string", "minLength": 1},
    "method_summary": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "model_version": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "created_at": {"$ref": "common-v1.json#/$defs/timestamp"},
    "cited_node_ids": {"type": "array", "items": {"type": "string"}},
    "cited_sources": {"type": "array", "items": {"$ref": "#/$defs/citedSource"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "alternatives": {"type": "array", "items": {"type": "string"}},
    "counter_evidence": {"type": "array", "items": {"type": "string"}},
    "sensitivity": {"type": ["string", "null"]},
    "human_validation_state": {"enum": ["unreviewed", "accepted", "rejected", "needs_revision"]},
    "schema_version": {"$ref": "common-v1.json#/$defs/schemaVersion"}
  }
}
