{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moviemuse.local/schemas/domain/scene-space-v1.json",
  "title": "SceneSpace",
  "$defs": {
    "subjectPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "x", "y"],
      "properties": {
        "subject_id": {"type": "string", "minLength": 1},
        "x": {"type": "number"},
        "y": {"type": "number"},
        "orientation_degrees": {"type": "number", "minimum": 0, "exclusiveMaximum": 360}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "scene_id", "geometry_description", "schema_version"],
  "properties": {
    "id": {"$ref": "common-v1.json#/$defs/sceneSpaceId"},
    "scene_id": {"$ref": "common-v1.json#/$defs/sceneId"},
    "geometry_description": {"type": "string", "minLength": 1},
    "subject_positions": {"type": "array", "items": {"$ref": "#/$defs/subjectPosition"}},
    "locked_attributes": {"type": "array", "items": {"type": "string"}},
    "schema_version": {"$ref": "common-v1.json#/$defs/schemaVersion"}
  }
}
